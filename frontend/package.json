{
  "name": "factory-product-code-validator",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --port 3002",
    "dev:frontend": "vite --port 3002",
    "dev:backend": "node --watch ../backend/server.js",
    "dev:full": "concurrently -n backend,frontend -c bgBlue.white,bgGreen.white \"node ../backend/server.js\" \"vite --port 3002\"",
    "build": "vite build",
    "preview": "vite preview"
  },
  "dependencies": {
    "factory-product-code-validator-workspace": "file:..",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@types/node": "^22.14.0",
    "@vitejs/plugin-react": "^5.0.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.0"
  }
}
