# ── Persistence (Turso / libSQL) ───────────────────────────────────────────
# REQUIRED in production (e.g. Render): the host's disk is ephemeral, so without
# these the SQLite DB resets on every deploy/restart. Leave BLANK for local dev
# (the backend then uses backend/data/app.db). Create a free DB at
# https://app.turso.tech
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# ── OCR Configuration ──────────────────────────────────────────────────────
# Gemini API key (primary OCR engine).
# Get yours free at: https://aistudio.google.com/app/apikey
# If omitted or blank, the app falls back to local OCR (Tesseract + PaddleOCR).
GEMINI_API_KEY=

# Optional: override the Gemini model (default: gemini-2.5-flash)
# GEMINI_MODEL=gemini-2.5-flash

# Optional: Gemini request timeout in milliseconds (default: 30000)
# GEMINI_TIMEOUT_MS=30000

# ── Local OCR fallback ──────────────────────────────────────────────────────
# Set to "tesseract" to skip PaddleOCR entirely and use only Tesseract.
# Default is "paddle" (PaddleOCR → Tesseract fallback chain).
# OCR_ENGINE=paddle

# ── Server ─────────────────────────────────────────────────────────────────
# PORT=3001
